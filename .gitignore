# === WorkBuddy AI 私有数据（勿提交）===
.workbuddy-ai/
.workbuddy/
**/.workbuddy-ai/
**/.workbuddy/

# === 运行时生成的状态/缓存文件 ===
# uosc_staff_credits 运行时产物（历史、运行时配置、数据缓存）
staff-credits-history.json
staff-credits-runtime-config.json
staff-credits-data-cache.json
recent.json
# uosc_danmaku 运行时产物（搜索历史，路径见 search_history_path）
danmaku-search-history.json
# uosc_subtitle_style 运行时产物（样式状态、字体缓存、预设缓存）
uosc-subtitle-style-state.json
uosc-subtitle-style-fonts.json
sub-style-preset.json
# uosc_updater 运行时产物（检查状态、GitHub API 响应缓存）
uosc-updater-state.json
uosc-updater-remote.json
# uosc_subtitle_style 更新时的暂存/中转文件（正常路径不会残留，防止异常中断后误提交）
*.lua.new
*.lua.tmpbak

# === 例外：确需纳入版本管理的文件 ===
# file-browser 收藏夹为用户配置，需保留
!script-opts/file_browser_favourites.txt

# === 外部独立仓库维护的脚本（此处只放 clone，不做文件级跟踪）===
# uosc_danmaku 是独立 fork 仓库（https://github.com/awujiana/uosc_danmaku），
# 单独 clone 到 scripts/uosc_danmaku，改动只在 fork 仓库提交，避免双份记录。
# 重装环境时执行：git clone https://github.com/awujiana/uosc_danmaku.git scripts/uosc_danmaku
scripts/uosc_danmaku/

# uosc_staff_credits 是独立仓库（https://github.com/awujiana/uosc-staff-credits），
# 单独 clone 到 scripts/uosc_staff_credits，改动只在独立仓库提交。
# 重装环境时执行：git clone https://github.com/awujiana/uosc-staff-credits.git scripts/uosc_staff_credits
scripts/uosc_staff_credits/
