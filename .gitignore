# === WorkBuddy AI 私有数据（勿提交）===
.workbuddy-ai/
.workbuddy/
**/.workbuddy-ai/
**/.workbuddy/

# === 运行时生成的状态/缓存文件 ===
# uosc_staff_credits 运行时产物（历史、运行时配置、数据缓存）
staff-credits-history.json
staff-credits-runtime-config.json
staff-credits-data-cache.json
recent.json
# uosc_danmaku 运行时产物（搜索历史，路径见 search_history_path）
danmaku-search-history.json
# uosc_subtitle_style 运行时产物（样式状态、字体缓存、预设缓存）
uosc-subtitle-style-state.json
uosc-subtitle-style-fonts.json
sub-style-preset.json
# uosc_updater 运行时产物（检查状态、GitHub API 响应缓存）
uosc-updater-state.json
uosc-updater-remote.json
# uosc_subtitle_style 更新时的暂存/中转文件（正常路径不会残留，防止异常中断后误提交）
*.lua.new
*.lua.tmpbak

# === 例外：确需纳入版本管理的文件 ===
# file-browser 收藏夹为用户配置，需保留
!script-opts/file_browser_favourites.txt

# === 独立仓库维护的脚本（以 git submodule 形式纳入，见 .gitmodules）===
# uosc_danmaku / uosc_staff_credits 是各自独立的仓库，在包里以 submodule 记录指向，
# 不在父仓库做文件级跟踪。克隆本仓库时需要：
#   git clone --recursive https://github.com/awujiana/mpv-bingshan.git
# 已克隆过的话补一条：
#   git submodule update --init --recursive
# 改动只在各自的子仓库提交，父仓库只更新指向的提交号。
